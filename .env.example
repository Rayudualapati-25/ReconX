# Copy to .env for local development outside Docker. Never commit a real .env.
# These values are local-only placeholders that match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://reconx:reconx@localhost:5432/reconx

# Used by the test suite; it must point at a disposable database whose name ends in _test.
TEST_DATABASE_URL=postgresql+psycopg://reconx:reconx@localhost:5432/reconx_test
